{
  "auto_install_extensions": {
    "dockerfile": true,
    "git-firefly": true,
    "groovy": true,
    "html": true,
    "java": true,
    "kotlin": true,
    "php": true,
    "sql": true,
    "toml": true,
    "xml": true
  },
  "proxy": "",
  "outline_panel": {
    "dock": "left"
  },
  "diff_view_style": "unified",
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "cli_default_open_behavior": "existing_window",
  "ensure_final_newline_on_save": false,
  "remove_trailing_whitespace_on_save": false,
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "tabs": {
    "file_icons": false,
    "git_status": true
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": true
  },
  "tab_size": 4,
  "hard_tabs": false,
  "format_on_save": "off",
  "autosave": "on_focus_change",
  "buffer_font_weight": 100,
  "buffer_font_size": 14,
  "ui_font_size": 14,
  "agent": {
    "sidebar_side": "right",
    "dock": "left",
    "flexible": true,
    "default_model": {
      "provider": "zed.dev",
      "model": "gemini-2.5-pro"
    },
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "grok-code-fast-1"
    },
    "model_parameters": []
  },
  "wsl_connections": [
    {
      "distro_name": "Ubuntu-22.04",
      "user": null,
      "projects": [
        {
          "paths": ["/home/hacker"]
        },
        {
          "paths": ["/home/hacker/dev/api-pmc"]
        },
        {
          "paths": ["/home/hacker/dev/vitae-homecare2.0"]
        }
      ]
    }
  ],
  "telemetry": {
    "diagnostics": true,
    "metrics": true
  },
  "file_types": {},
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Catppuccin Macchiato"
  },
  "terminal": {
    "font_size": 12.0
  },
  "git": {
    "disable_git": false,
    "inline_blame": {
      "enabled": true
    }
  },
  "base_keymap": "VSCode",
  "search": {
    "include_ignored": false
  },
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "auto"
  },
  "vim_mode": true,
  "relative_line_numbers": "disabled",
  "vim": {
    "use_system_clipboard": "always",
    "toggle_relative_line_numbers": false
  },
  "project_panel": {
    "dock": "right",
    "default_width": 240
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark"
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "analysis": {
          "diagnosticMode": "workspace",
          "inlayHints.callArgumentNames": false
        }
      }
    }
  },
  "debugger": {
    "log_dap_communications": true
  },
  "command_aliases": {
    "W": "w",
    "Wq": "wq",
    "Q": "q"
  }
}